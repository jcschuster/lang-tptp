{
  "name": "tree-sitter-tptp",
  "version": "0.1.0",
  "description": "TPTP grammar for tree-sitter, generated from the TPTP SyntaxBNF",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcschuster/lang-tptp.git",
    "directory": "packages/tree-sitter-tptp"
  },
  "funding": "",
  "license": "MIT",
  "tptp": {
    "bnf": "9.3.1.6"
  },
  "author": {
    "name": "Johannes Schuster",
    "email": "johannes.c.schuster@proton.me",
    "url": "https://jcschuster.de"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "tptp"
  ],
  "files": [
    "NOTICE",
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  }
}
